#!/usr/bin/env bash
# Git pre-commit hook: compile what this commit touches, without opening Unity.
# Install: cp examples/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Works in Git Bash on Windows. Skip once with: git commit --no-verify
set -euo pipefail
root=$(git rev-parse --show-toplevel)

# --changed HEAD covers staged, unstaged and untracked changes since the last commit; assemblies that
# depend on a changed assembly are checked too. Exit 0 also allows warnings.
if ! ucl check "$root" --changed HEAD; then
  echo "ucl: compile errors above; fix them or commit with --no-verify" >&2
  exit 1
fi
